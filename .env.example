# 本地一键启动配置。复制为 .env 后修改；.env 不会提交到 Git。
HOST=127.0.0.1
SCOREBOARD_PORT=3000
QUIZ_PORT=3001

# 正式比赛前必须替换为高强度口令。
SCORE_A_PASSWORD=请修改为A路线强口令
SCORE_B_PASSWORD=请修改为B路线强口令
SCORE_AUTH_SECRET=请修改为至少32位随机字符串
ADMIN_PASSWORD=请修改为题库管理强口令

# 可选：本地持久化目录。相对路径以项目根目录为基准。
SCOREBOARD_DATA_DIR=data/scoreboard
QUIZ_DATA_DIR=data/quiz

# 可选：默认会自动指向本机题库服务。
# QUIZ_TEAMS_URL=http://127.0.0.1:3001/api/integrations/scoreboard/teams
# QUIZ_SYNC_INTERVAL_MS=10000
