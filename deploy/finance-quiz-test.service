[Unit]
Description=Finance Quiz Test Website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quiztest
Group=quiztest
WorkingDirectory=/opt/finance-quiz-test
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DATA_DIR=/var/lib/finance-quiz-test
EnvironmentFile=/etc/finance-quiz-test.env
ExecStart=/usr/bin/node /opt/finance-quiz-test/quiz-server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/finance-quiz-test

[Install]
WantedBy=multi-user.target
